# Copy to `.env` beside compose.yaml and fill in.

# Required. Anything long and random — `openssl rand -base64 24`.
POSTGRES_PASSWORD=

# The first owner. Created once on the first boot, then ignored — a restart
# with these still set will not add a second account.
# Minimum 12 characters.
OWNER_EMAIL=
OWNER_PASSWORD=

# Set true once something in front terminates TLS. The session cookie is then
# marked Secure, which is what stops it travelling over plain HTTP — and why it
# is off by default, since a first install is often plain HTTP on a LAN.
SECURE_COOKIES=false

# What the starter page says. Change it later from the spec.
SITE_NAME=My business

# Used for the sitemap and canonical URLs (doc 08). Set it once you have a
# domain; until then the site works without it.
PUBLIC_URL=

# Where the site is served. Change if 8080 is taken.
HTTP_PORT=8080

# IANA name, e.g. Africa/Nairobi. Availability is computed against it.
SITE_TIMEZONE=UTC

# Set to true only when something in front terminates TLS and sets
# X-Forwarded-Host. Trusting it otherwise lets a caller choose their own host.
TRUST_PROXY=false

# Pin a release instead of tracking latest.
VERSION=latest

# Optional overrides.
# POSTGRES_USER=forinda
# POSTGRES_DB=forinda_cms
