{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forinda-cms.dev/schema/workflow.schema.json",
  "title": "forinda-cms workflow",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "on": {
              "type": "string",
              "const": "entry.created"
            },
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            }
          },
          "required": [
            "on",
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "on": {
              "type": "string",
              "const": "entry.updated"
            },
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            }
          },
          "required": [
            "on",
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "on": {
              "type": "string",
              "const": "entry.transitioned"
            },
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            },
            "to": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            }
          },
          "required": [
            "on",
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "on": {
              "type": "string",
              "const": "form.submitted"
            },
            "form": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            }
          },
          "required": [
            "on",
            "form"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "on": {
              "type": "string",
              "const": "flow.completed"
            },
            "flow": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            }
          },
          "required": [
            "on",
            "flow"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "on": {
              "type": "string",
              "const": "payment.succeeded"
            },
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            }
          },
          "required": [
            "on"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "on": {
              "type": "string",
              "const": "schedule"
            },
            "cron": {
              "type": "string"
            }
          },
          "required": [
            "on",
            "cron"
          ],
          "additionalProperties": false
        }
      ]
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
          },
          "params": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "when": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*$"
              },
              "op": {
                "type": "string",
                "enum": [
                  "eq",
                  "ne",
                  "lt",
                  "lte",
                  "gt",
                  "gte",
                  "in",
                  "contains",
                  "exists",
                  "empty"
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "param": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                      },
                      "default": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "param"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "entry": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[a-z][a-zA-Z0-9]*$"
                      }
                    },
                    "required": [
                      "entry"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "field",
              "op"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    },
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "key",
    "trigger",
    "steps"
  ],
  "additionalProperties": false
}
