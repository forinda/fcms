# Local development. `.env.test` overrides this under vitest; the shell
# overrides both.
PORT=8800
NODE_ENV=development
LOG_LEVEL=info

# The only variable with no default — the app refuses to boot without it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/forinda_cms

# Where a single-site install serves from (ADR 0013, doc 09). v1 is one org and
# one site, and neither word appears in the UI.
ORG_ID=default
SITE_ID=default

# The first owner, created once on first boot and then ignored. A restart with
# these still set cannot mint a second account.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me-at-least-12-chars

# Shown on the starter page a fresh install boots into.
SITE_NAME=A new site
SITE_TIMEZONE=Africa/Nairobi

# Off for local HTTP: a cookie marked Secure never arrives over plain HTTP, and
# an unconditionally trusted X-Forwarded-Host lets a caller pick which site they
# get once multi-site exists.
SECURE_COOKIES=false
TRUST_PROXY=false

# Absolute base for canonicals and the sitemap (doc 08). Unset falls back to the
# request's host.
# PUBLIC_URL=https://example.com
