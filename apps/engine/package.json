{
  "name": "@forinda-cms/engine",
  "version": "0.0.0",
  "private": true,
  "description": "The HTTP engine: the public site, the admin, and the management API.",
  "type": "module",
  "scripts": {
    "dev": "kick dev",
    "build": "kick build && vite build --config vite.client.config.ts",
    "start": "kick start",
    "typecheck": "kick typegen && tsc --noEmit && tsc --noEmit -p src/client",
    "test": "vitest run",
    "schema": "tsx scripts/emit-schema.ts",
    "schema:check": "tsx scripts/emit-schema.ts --check",
    "seed": "tsx scripts/seed-example.ts"
  },
