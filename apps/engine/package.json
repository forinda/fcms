    "@forinda-cms/render": "workspace:*",
    "@forinda-cms/spec": "workspace:*",
    "@forinda/kickjs": "catalog:",
    "@forinda/kickjs-inertia": "catalog:",
    "@forinda/kickjs-schema": "catalog:",
