# The suite's environment, beside the app whose suite it is.
#
# The repo root has one of these, and `vitest.config.ts` loads it — but the
# framework's own loader runs later, in the worker, and reads THIS directory.
# With no `.env.test` here it fell through to `apps/engine/.env`, so the suites
# ran against the DEVELOPMENT database and truncated it. Nothing fails when that
# happens: every test passes, and the site you had open in another tab quietly
# loses its owner and its rows.
#
# A file here stops that fallback: in test mode the loader uses `.env.test.local`
# and `.env.test` alone when either exists. An exported variable still wins over
# both, which is how CI points the same suite at its own server.
#
# The values below match the root file and CI's service container. If your
# database is somewhere else, put yours in `.env.test.local` — never in this one.
NODE_ENV=test
PORT=0
LOG_LEVEL=silent
DATABASE_URL=postgres://postgres:postgres@localhost:5432/forinda_cms_test
ORG_ID=default
SITE_ID=default
