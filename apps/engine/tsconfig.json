{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": true
  },
  "include": ["src", "scripts", ".kickjs/types/**/*.d.ts", ".kickjs/types/**/*.ts"],
  "//": "The pages have their own program (src/client/tsconfig.json): DOM and JSX do not belong in the server's.",
  "exclude": ["src/client"]
}
