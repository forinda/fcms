---
/**
 * The shell every page uses.
 *
 * One layout, no framework, and the only JavaScript on the site is the eight
 * lines at the bottom that make a copy button work — a marketing site arguing
 * that software should be small cannot ship a hydration runtime to say so.
 */
import '../styles/site.css'

interface Props {
  title: string
  description: string
  /** Shown above the page's own heading, so a reader knows where they are. */
  section?: string
  /** Wide pages lay their own content out; prose pages get one readable column. */
  width?: 'prose' | 'wide'
}

const { title, description, section, width = 'prose' } = Astro.props
const path = Astro.url.pathname

const NAV = [
  { href: '/features/', label: 'What it does' },
  { href: '/docs/', label: 'Docs' },
  { href: '/pricing/', label: 'Pricing' },
]

const FOOTER = [
  {
    title: 'Product',
    links: [
      { href: '/features/', label: 'What it does' },
      { href: '/pricing/', label: 'Pricing' },
      { href: '/docs/install/', label: 'Install' },
    ],
  },
  {
    title: 'Documentation',
    links: [
      { href: '/docs/editing/', label: 'Run your site' },
      { href: '/docs/automations/', label: 'Automations' },
      { href: '/docs/developers/', label: 'Build with it' },
      { href: '/docs/operating/', label: 'Keep it running' },
    ],
  },
]

const current = (href: string) => path === href || (href !== '/' && path.startsWith(href))
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="site-header">
      <div class="bar">
        <a href="/" class="wordmark"><span class="mark">f</span> forinda&#8203;-cms</a>
        <nav>
          {NAV.map((item) => (
            <a href={item.href} class={current(item.href) ? 'here' : ''}>{item.label}</a>
          ))}
        </nav>
        <a class="cta small" href="/docs/install/">Install</a>
      </div>
    </header>

    <main>
      <slot name="hero" />
      <div class={width}>
        {section && <p class="eyebrow">{section}</p>}
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="cols">
        <div>
          <a href="/" class="wordmark"><span class="mark">f</span> forinda&#8203;-cms</a>
          <p class="about">
            A self-hostable CMS where the site is a spec. Your database, your export, no
            account required.
          </p>
        </div>
        {FOOTER.map((group) => (
          <div>
            <h4>{group.title}</h4>
            <ul>
              {group.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </footer>

    <script is:inline>
      // The only script on the site. Without it every code block still reads
      // and still selects; the button simply does nothing, so it is hidden.
      for (const button of document.querySelectorAll('.copy')) {
        if (!navigator.clipboard) {
          button.remove()
          continue
        }
        button.addEventListener('click', async () => {
          await navigator.clipboard.writeText(button.dataset.copy ?? '')
          button.textContent = 'Copied'
          button.dataset.copied = 'true'
          setTimeout(() => {
            button.textContent = 'Copy'
            delete button.dataset.copied
          }, 1600)
        })
      }
    </script>
  </body>
</html>
