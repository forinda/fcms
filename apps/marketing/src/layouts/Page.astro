---
/**
 * The shell every page uses.
 *
 * One layout, no framework, no client JavaScript. A marketing site that ships a
 * hydration runtime to say what a product is has already lost the argument it
 * is making about weight — and doc 14's reader is on a phone, on a network that
 * charges by the megabyte.
 */
interface Props {
  title: string
  description: string
  /** Shown above the page's own heading, so a reader knows where they are. */
  section?: string
}

const { title, description, section } = Astro.props
const path = Astro.url.pathname

const NAV = [
  { href: '/features/', label: 'What it does' },
  { href: '/docs/', label: 'Docs' },
  { href: '/pricing/', label: 'Pricing' },
]

const current = (href: string) => path === href || (href !== '/' && path.startsWith(href))
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <style is:global>
      :root {
        color-scheme: light dark;
        --ink: #1c1917;
        --muted: #57534e;
        --line: #e7e5e4;
        --brand: #1a7f5a;
        --bg: #fafaf9;
        --card: #ffffff;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --ink: #e7e5e4;
          --muted: #a8a29e;
          --line: #44403c;
          --bg: #1c1917;
          --card: #292524;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font: 17px/1.65 system-ui, -apple-system, "Segoe UI", sans-serif;
      }
      header {
        display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
        max-width: 60rem; margin: 0 auto; padding: 1.25rem 1.25rem 0; flex-wrap: wrap;
      }
      .wordmark { font-weight: 600; letter-spacing: -0.02em; text-decoration: none; color: var(--ink); }
      header nav { display: flex; gap: 1.1rem; flex-wrap: wrap; }
      header nav a { text-decoration: none; color: var(--muted); font-size: 0.95rem; }
      header nav a:hover, header nav a.here { color: var(--ink); }
      .eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem;
        color: var(--muted); margin: 0 0 0.5rem; }
      main { max-width: 46rem; margin: 0 auto; padding: 2.5rem 1.25rem 6rem; }
      h1 { font-size: clamp(2rem, 6vw, 3rem); line-height: 1.1; margin: 0 0 1rem; letter-spacing: -0.02em; }
      h2 { font-size: 1.35rem; margin: 3rem 0 0.75rem; letter-spacing: -0.01em; }
      p { margin: 0 0 1rem; }
      .lede { font-size: 1.2rem; color: var(--muted); }
      a { color: var(--brand); }
      code, pre { font-family: ui-monospace, SFMono-Regular, monospace; font-size: 0.9em; }
      pre {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 1rem;
        overflow-x: auto;
      }
      .cards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); margin-top: 1rem; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 1.1rem; }
      .card h3 { margin: 0 0 0.35rem; font-size: 1rem; }
      .card p { margin: 0; color: var(--muted); font-size: 0.95rem; }
      .cta { display: inline-block; background: var(--brand); color: #fff; text-decoration: none;
        padding: 0.6rem 1.1rem; border-radius: 8px; font-weight: 500; }
      .cta.secondary { background: transparent; color: var(--brand); border: 1px solid var(--brand); }
      .ctas { display: flex; gap: 0.75rem; flex-wrap: wrap; margin: 1.5rem 0 0; }
      table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.95rem; }
      th, td { text-align: left; padding: 0.55rem 0.6rem; border-bottom: 1px solid var(--line);
        vertical-align: top; }
      th { color: var(--muted); font-weight: 600; font-size: 0.85rem; }
      .note { border-left: 3px solid var(--brand); padding: 0.1rem 0 0.1rem 0.9rem;
        margin: 1.25rem 0; color: var(--muted); }
      .soon { display: inline-block; font-size: 0.7rem; text-transform: uppercase;
        letter-spacing: 0.06em; background: var(--line); color: var(--muted);
        padding: 0.1rem 0.4rem; border-radius: 99px; vertical-align: middle; }
      ol { padding-left: 1.2rem; }
      ol li { margin: 0.45rem 0; }
      footer { border-top: 1px solid var(--line); margin-top: 4rem; padding-top: 1.5rem; color: var(--muted); font-size: 0.9rem; }
    </style>
  </head>
  <body>
    <header>
      <a href="/" class="wordmark">forinda&#8203;-cms</a>
      <nav>
        {NAV.map((item) => (
          <a href={item.href} class={current(item.href) ? 'here' : ''}>{item.label}</a>
        ))}
      </nav>
    </header>

    <main>
      {section && <p class="eyebrow">{section}</p>}
      <slot />
      <footer>
        <p>
          Self-hostable. Your database, your export, no account required.
          <br />
          <a href="/docs/install/">Install it</a> · <a href="/docs/">Documentation</a> ·
          <a href="/pricing/">Pricing</a>
        </p>
      </footer>
    </main>
  </body>
</html>
