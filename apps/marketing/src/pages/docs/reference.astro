/**
 * The spec language, generated from the spec package.
 *
 * A hand-written reference is a reference that rots: a field type added to the
 * schema and not to the page is a feature nobody can find, and one removed from
 * the schema and not from the page is a promise that fails. So the tables here
 * are built at build time from `FIELD_TYPES` and `CORE_BLOCKS` — the same
 * definitions the admin's builder and the renderer use. If a block exists, it
 * is on this page, and the marketing build fails before a wrong page ships.
 */
import Docs from '../../layouts/Docs.astro'
import { FIELD_TYPES, OPERATORS } from '@forinda-cms/spec'
import { CORE_BLOCKS } from '@forinda-cms/render'

const fields = FIELD_TYPES.filter((f) => !f.computed)
const derivedFields = FIELD_TYPES.filter((f) => f.computed)

const blocks = Object.values(CORE_BLOCKS)
  .map((b) => ({ name: b.name, summary: b.summary, attrs: [...b.attrs], variants: [...(b.variants ?? [])] }))
  .sort((a, b) => a.name.localeCompare(b.name))
