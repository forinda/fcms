{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    ".kickjs",
    "examples",
    ".astro",
    ".output"
  ],
  "rules": {
    "no-console": "off",
    "no-underscore-dangle": "off",
    "no-await-in-loop": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/consistent-function-scoping": "off",
    "typescript/no-explicit-any": "off"
  },
  "overrides": [
    {
      "files": [
        "apps/**/*.ts",
        "packages/!(db)/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "drizzle-orm/pg-core",
                  "drizzle-orm/sqlite-core",
                  "drizzle-orm/postgres-js",
                  "postgres",
                  "better-sqlite3"
                ],
                "message": "Only `packages/db` may name a database dialect (ADR 0049). Use the Drizzle query builder and the helpers from `dialectOf(db)`."
              }
            ]
          }
        ]
      }
    }
  ]
}
