{
  "name": "forinda-cms",
  "version": "2026.7.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --filter @forinda-cms/engine dev",
    "fcms": "tsx packages/cli/src/bin.ts",
    "build": "pnpm --filter @forinda-cms/admin build && pnpm --filter @forinda-cms/engine build && pnpm --filter @forinda/fcms-cli build",
    "start": "pnpm --filter @forinda-cms/engine start",
    "typecheck": "pnpm -r --no-bail run typecheck",
    "test": "pnpm -r --no-bail run test",
    "lint": "oxlint apps packages",
    "lint:fix": "oxlint --fix apps packages",
    "format": "oxfmt apps packages",
    "format:check": "oxfmt --check apps packages",
    "schema": "pnpm --filter @forinda-cms/engine schema",
    "schema:check": "pnpm --filter @forinda-cms/engine schema:check",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm schema:check && pnpm test",
    "release": "node scripts/release.mjs",
    "notes": "node scripts/notes.mjs",
    "docker:build": "docker build -t forinda-cms:local .",
    "dev:app": "pnpm --filter @forinda-cms/admin dev"
  },
  "devDependencies": {
    "esbuild": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
