{
  "name": "@forinda-cms/db",
  "version": "0.0.0",
  "private": true,
  "description": "Postgres persistence: sites, specs, and the patch spine.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate-cli.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "catalog:",
    "@forinda-cms/render": "workspace:*",
    "@forinda-cms/spec": "workspace:*",
    "@forinda/kickjs-db": "catalog:",
    "@node-rs/argon2": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "postgres": "catalog:",
    "uuidv7": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
