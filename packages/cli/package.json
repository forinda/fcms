{
  "name": "@forinda-cms/cli",
  "version": "0.0.0",
  "private": true,
  "description": "fcms — the management CLI. Netlify-shaped, not WP-CLI-shaped.",
  "bin": {
    "fcms": "./src/bin.ts"
  },
