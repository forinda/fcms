{
  "name": "@forinda/fcms-cli",
  "version": "0.0.0",
  "description": "fcms — the forinda-cms management CLI. Validate, format, preview and publish a site from a directory of YAML.",
  "keywords": [
    "cli",
    "cms",
    "static-site",
    "yaml"
  ],
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forinda/fcms.git",
    "directory": "packages/cli"
  },
  "bin": {
    "fcms": "./src/bin.ts"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "bin": {
      "fcms": "./dist/fcms.mjs"
    },
    "main": "./dist/fcms.mjs",
    "types": null,
    "exports": null,
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/bundle.mjs",
    "prepack": "node ../../scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fcms": "tsx src/bin.ts"
  },
  "dependencies": {
    "commander": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@forinda-cms/lang": "workspace:*",
    "@forinda-cms/render": "workspace:*",
    "@forinda-cms/sdk": "workspace:*",
    "@forinda-cms/spec": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
