    "drizzle-orm": "catalog:",
    "express": "catalog:",
    "multer": "catalog:",
    "postgres": "catalog:",
    "reflect-metadata": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
