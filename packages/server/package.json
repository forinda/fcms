{
  "name": "@forinda/fcms-core",
  "version": "2026.6.0",
  "description": "Run a forinda-cms site. Needs Node and a Postgres URL; no Docker required.",
  "keywords": [
    "cms",
    "headless",
    "postgres",
    "self-hosted"
  ],
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forinda/fcms.git",
    "directory": "packages/server"
  },
  "bin": {
    "forinda-cms": "./bin/forinda-cms.mjs"
  },
  "files": [
    "bin",
    "dist",
    "migrations",
    "app",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/pack.mjs",
    "typecheck": "node --check bin/forinda-cms.mjs",
    "prepack": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "catalog:",
    "@forinda/kickjs": "catalog:",
    "@forinda/kickjs-schema": "catalog:",
    "@node-rs/argon2": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "express": "catalog:",
    "multer": "catalog:",
    "postgres": "catalog:",
    "reflect-metadata": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
